@startuml
skinparam style strictuml
skinparam sequenceMessageAlign center

actor "Usuário" as User
participant "Frontend (React)" as FE
participant "API Flask" as API
participant "Auth Middleware" as Auth
participant "Post Service" as SVC
participant "Supabase Storage" as Cloud
database "PostgreSQL" as DB

User -> FE : Preenche dados e anexa fotos
FE -> API : POST /posts (multipart/form-data)
activate API

API -> Auth : Valida JWT Token
activate Auth

alt Token Inválido ou Expirado
    Auth --> API : Erro de Autenticação
    API --> FE : HTTP 401 (Unauthorized)
    FE -> User : Redireciona para Login
else Token Válido
    Auth --> API : User ID
    deactivate Auth

    API -> SVC : create_post(user_id, data, files)
    activate SVC

    SVC -> DB : INSERT INTO posts (status='pending')
    activate DB
    DB --> SVC : post_id
    deactivate DB

    loop para cada imagem
        SVC -> Cloud : Upload binário
        activate Cloud

        alt Falha no Upload (Supabase fora ou erro de rede)
            Cloud --> SVC : Erro de Upload
            SVC -> DB : DELETE FROM posts WHERE id=post_id
            SVC --> API : Falha no Upload
            API --> FE : HTTP 500 (Erro no Storage)
            FE -> User : Mensagem: "Erro ao subir imagens. Tente novamente."
        else Upload Sucesso
            Cloud --> SVC : URL da imagem
            deactivate Cloud
            SVC -> DB : INSERT INTO images (post_id, url)
            activate DB
            DB --> SVC : Sucesso
            deactivate DB
        end
    end

    SVC -> DB : UPDATE posts SET status='active'
    activate DB
    DB --> SVC : Sucesso
    deactivate DB

    SVC --> API : Post Criado
    deactivate SVC
    API --> FE : HTTP 201 Created
    deactivate API
    FE -> User : Sucesso!
end
@enduml