@startuml
autonumber
skinparam style strictuml

actor "Usuário/Visitante" as User
participant "Frontend" as UI

box "Backend" #f9f9f9
    participant "Camada de Interface" as CI
    participant "Camada de Negócio" as CN
    participant "Camada de Dados" as CD
end box

box "Infra" #e8f4f8
    participant "PostgreSQL (DB)" as DB
end box

== Fluxo: Visualizar Feed ==

User -> UI : Aplica filtros no feed (params)
activate UI
UI -> CI : GET /posts?params
activate CI
CI -> CI : Valida Entrada (FeedRequestSchema)
activate CI
deactivate CI

alt Parâmetros inválidos ou incompletos
    CI --> UI : 400 Bad Request
    UI --> User : Exibe alertas nos filtros
else Parâmetros Ok
    CI -> CN : Buscar Posts Filtrados (params)
    activate CN
    CN -> CN : Tratamento de Defaults:\n- Se coords null: Curitiba\n- Se radius null: 10km\n- Se filters null: "Todos"
    activate CN
    deactivate CN
    CN -> CD : Query Customizada (params)
    activate CD
    note right of CD
        A query aplica filtros:
        - status IN ('active', 'resolved')
        - st_distance < radius
        - pet_type AND category (se enviados)
        - JOIN com User e Images (Eager Loading)
    end note
    CD -> DB : SELECT + JOINs + Geo + Paginação
    activate DB
    DB --> CD : Lista de Objetos (Posts + Relacionados)
    deactivate DB
    CD --> CN : Lista de Objetos
    deactivate CD
    CN -> CN : Formata PostResponseSchema\n(Filtra campos do Autor e gera lista de Images)
    activate CN
    deactivate CN
    CN --> CI : 0..* PostResponseSchema
    deactivate CN
    CI --> UI : 200 OK
    deactivate CI
    UI --> User : Exibe cards no Feed
    deactivate UI
end

== Fluxo: Visualizar Mapa ==

User -> UI : Clica na aba Mapa
activate UI
UI -> CI : GET /map/pins?params
activate CI
CI -> CI : Valida Entrada (MapPinsRequestSchema)
activate CI
deactivate CI

alt Parâmetros inválidos ou incompletos
    CI --> UI : 400 Bad Request
    UI --> User : Exibe alertas nos filtros
else Parâmetros Ok
    CI -> CN : Buscar Pins Filtrados (params)
    activate CN
    CN -> CN : Tratamento de Defaults:\n- Se coords null: Curitiba\n- Se filters null: "Todos"
    activate CN
    deactivate CN
    CN -> CD : Contar pins na área (params)
    activate CD
    CD -> DB : SELECT COUNT(id) FROM posts WHERE...
    activate DB
    DB --> CD : total_count
    deactivate DB
    CD --> CN : total_count
    deactivate CD
    alt Excede limite
        CN --> CI : OversizedContentError
        CI --> UI : 413 Content Too Large
        UI --> User : "Excedeu limite de pins."
    else Densidade Ok
        CN -> CD : Buscar Pins (params)
        activate CD
        CD -> DB : SELECT id, params FROM posts...
        activate DB
        DB --> CD : Lista de Objetos
        deactivate DB
        CD --> CN : Lista de Objetos
        deactivate CD
        CN --> CI : 0..* PinResponseSchema
        deactivate CN
        CI --> UI : 200 OK
        deactivate CI
        UI --> User : Exibe mapa com pins
        deactivate UI
    end
end

== Fluxo: Visualizar Detalhes de um Pin no Mapa ==

User -> UI : Clica em um Pin no Mapa
activate UI
UI -> CI : GET /posts/post_id
activate CI
CI -> CI : Valida Entrada (int)
activate CI
deactivate CI

alt Parâmetros inválidos ou incompletos
    CI --> UI : 400 Bad Request
    UI --> User : Exibe alertas
else Parâmetros Ok
    CI -> CN : Obter Detalhes do Post (post_id)
    activate CN
    CN -> CD : Buscar Post por ID (Eager Loading)
    activate CD
    CD -> DB : SELECT + JOINs (User, Images) WHERE id = post_id
    activate DB
    DB --> CD : Objeto (Post + Relacionados) ou null
    deactivate DB
    CD --> CN : Objeto ou null
    deactivate CD

    alt Post não existe
        CN --> CI : ResourceNotFoundError
        CI --> UI : 404 Not Found
        UI --> User : "Post não encontrado."
    else Post existe
        CN -> CN : Verifica status
        activate CN
        deactivate CN

        alt Status é 'hidden' ou 'banned'
            CN --> CI : ResourceNotFoundError
            CI --> UI : 404 Not Found
            UI --> User : "Post não encontrado."
        else Status é 'active' ou 'resolved'
            CN -> CN : Formata PostResponseSchema\n(Filtra campos do Autor e gera lista de Images)
            activate CN
            deactivate CN
            CN --> CI : PostResponseSchema
            deactivate CN
            CI --> UI : 200 OK
            deactivate CI
            UI --> User : Abre detalhes completos
            deactivate UI
        end
    end
end
deactivate CN
deactivate CI
deactivate UI
@enduml