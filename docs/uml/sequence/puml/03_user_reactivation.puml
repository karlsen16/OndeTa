@startuml
autonumber
skinparam style strictuml

actor "Visitante" as Guest
participant "Frontend" as UI

box "Backend" #f9f9f9
    participant "Camada de Interface" as CI
    participant "Camada de Negócio" as CN
    participant "Camada de Dados" as CD
end box

box "Infra" #e8f4f8
    participant "PostgreSQL (DB)" as DB
end box

== Fluxo: Reativar Conta ==

Guest -> UI : Aceita reativação da conta (email, password)
activate UI
UI -> CI : POST /auth/reactivate (email, password)
activate CI
CI -> CI : Valida Entrada (LoginSchema)
activate CI
deactivate CI

alt Dados inválidos ou incompletos
    CI --> UI : 400 Bad Request
    UI --> Guest : Exibe alertas nos campos
else Dados OK
    CI -> CN : Autentica (email, password)
    activate CN
    CN -> CD : Busca usuário (email)
    activate CD
    CD -> DB : Obtém usuário (email)
    activate DB
    DB --> CD : User / Null
    deactivate DB
    CD --> CN : User / Null
    deactivate CD
    CN -> CN : Valida credenciais
    activate CN
    deactivate CN

    alt Credenciais Inválidas
        CN --> CI : UnauthorizedError
        CI --> UI : 401 Unauthorized
        UI --> Guest : Exibe alertas nos campos
    else Credenciais OK
        CN -> CN : Verifica status (User)
        activate CN
        deactivate CN

        alt Conta banida
            CN --> CI : ForbiddenError
            CI --> UI : 403 Forbidden
            UI --> Guest : "Esta conta foi banida pela moderação."
        else Conta ativa
            CN --> CI : ConflictError
            CI --> UI : 409 Conflict
            UI --> Guest : "Esta conta já está ativa."
        else Conta inativa
            CN -> CD : Ativa conta (User)
            activate CD
            CD -> DB : Altera status do usuário\n(status=active)
            activate DB
            DB --> CD : User(status=active)
            deactivate DB
            CD --> CN : User
            deactivate CD
            CN -> CN : Gera JWT com claims (User)
            activate CN
            deactivate CN
            CN --> CI : token, User
            deactivate CN
            CI -> CI : Aplica AuthResponseSchema (token, User)
            activate CI
            deactivate CI
            CI --> UI : 200 OK (AuthResponse)
            deactivate CI
            UI --> Guest : Login realizado e conta reativada
            deactivate UI
        end
    end
end
@enduml