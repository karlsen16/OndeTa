@startuml
autonumber
skinparam style strictuml

actor "Administrador" as Admin
participant "Frontend" as UI

box "Backend" #f9f9f9
    participant "Camada de Interface" as CI
    participant "Camada de Negócio" as CN
    participant "Camada de Dados" as CD
end box

box "Infra" #e8f4f8
    participant "PostgreSQL (DB)" as DB
end box

== Fluxo: Banir Usuário ==

Admin -> UI : Clica em "Banir" no perfil do usuário
activate UI
UI -> CI : PATCH /admin/users/{user_id}
activate CI
CI -> CI : Valida Entrada (UserUpdateSchema)
alt Dados Inválidos
    CI --> UI : 400 Bad Request
    UI --> Admin : Exibe alertas nos campos
else Dados Ok
    CI -> CN : Atualiza user
    activate CN
    CN -> CN : Verifica Role (is_admin?)
    alt Não é Admin
        CN --> CI : Erro autenticação
        CI --> UI : 403 Forbidden
        UI --> Admin : "Não tem autorização."
    else É Admin
        CN -> CD : Atualiza Status do Usuário
        activate CD
        CD -> DB : UPDATE users SET status='banned'
        activate DB
        DB --> CD : Sucesso
        deactivate DB
        CD --> CN : Sucesso
        deactivate CD
        CN -> CD : Inativa todos os posts do usuário
        activate CD
        CD -> DB : UPDATE posts SET status='hidden' WHERE user_id=...
        activate DB
        DB --> CD : Sucesso
        deactivate DB
        CD --> CN : Sucesso
        deactivate CD
        CN --> CI : Sucesso
        deactivate CN
        CI --> UI : 200 OK
        deactivate CI
        UI --> Admin : "Usuário banido e posts escondidos."
        deactivate UI
    end
end
deactivate CI
deactivate UI
@enduml